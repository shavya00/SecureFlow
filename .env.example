# ==============================================================
# SecureFlow - Environment Variables Configuration Template
# ==============================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env   (or 'copy .env.example .env' in Windows CMD)
# 2. Fill in your actual Supabase database connection details below.
# 3. NEVER commit your actual '.env' file to Git or version control!
# ==============================================================

# Server Configuration
SERVER_PORT=8080

# Supabase PostgreSQL Database Connection
# --------------------------------------------------------------
# In your Supabase Dashboard:
# -> Go to: Project Settings -> Database
# -> Under "Connection string", select "JDBC" or "URI".
#
# Direct Connection (Port 5432):
# DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler (Port 6543 / Recommended for serverless / transaction mode):
# DB_URL=jdbc:postgresql://aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
# --------------------------------------------------------------
DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-database-password

# Optional Frontend Configuration (for reference)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# NOTE: NEVER put Supabase service_role secret key in frontend or public repositories!
